@echo off
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; Add-Type -AssemblyName System.IO.Compression.FileSystem; $r=Invoke-RestMethod 'https://api.github.com/repos/TO-HU-TIEU/extension/releases/latest'; $v=$r.tag_name.TrimStart('v'); if($v -notmatch '^\d+(\.\d+){0,3}$'){throw 'Invalid release'}; $url='https://github.com/TO-HU-TIEU/extension/releases/download/v'+$v+'/assistant-updater-'+$v+'.zip'; $asset=$r.assets | Where-Object {$_.browser_download_url -eq $url}; if(!$asset -or $asset.digest -notmatch '^sha256:[a-f0-9]{64}$'){throw 'Missing verified installer'}; $dir=Join-Path $env:TEMP ('assistant-setup-'+[Guid]::NewGuid()); New-Item -ItemType Directory -Path $dir | Out-Null; $zip=Join-Path $dir 'installer.zip'; Invoke-WebRequest $url -OutFile $zip -UseBasicParsing; if(('sha256:'+(Get-FileHash $zip -Algorithm SHA256).Hash.ToLower()) -ne $asset.digest){throw 'Installer checksum mismatch'}; [IO.Compression.ZipFile]::ExtractToDirectory($zip,(Join-Path $dir 'package')); & (Join-Path $dir 'package\install.ps1')"
pause

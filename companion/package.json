{
  "name": "x-reply-assistant",
  "version": "1.5.22",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build-extension.mjs",
    "start": "node scripts/build-extension.mjs",
    "demo": "node scripts/demo-server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",

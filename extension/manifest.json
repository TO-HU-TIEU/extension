{
  "manifest_version": 3,
  "name": "Assistant",
  "description": "Trợ lý nội dung theo ngữ cảnh, hỗ trợ phản hồi và tạo bài từ nhiều nguồn.",
  "version": "1.5.13",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "clipboardWrite",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "Mở Assistant",
    "default_icon": {
      "16": "assets/assistant-logo.svg",
      "32": "assets/assistant-logo.svg",
      "48": "assets/assistant-logo.svg",
      "128": "assets/assistant-logo.svg"
    }
  },
  "icons": {
    "16": "assets/assistant-logo.svg",
    "32": "assets/assistant-logo.svg",
    "48": "assets/assistant-logo.svg",
    "128": "assets/assistant-logo.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "ui-icons.js",
        "theme.js",
        "language.js",
        "reply-preferences.js",
        "reply-layout.js",
        "x-media.js",
        "x-content.js",
        "x-personalization.js",
        "follow.js"
      ],
      "css": [
        "x-content.css",
        "reply-ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/ai-generate.png",
        "assets/assistant-logo.svg"
      ],
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
